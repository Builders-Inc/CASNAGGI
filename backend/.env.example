# --- Database -------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017
DB_NAME=casnaggi

# --- CORS -----------------------------------------------------------------
# Exact frontend origins, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# --- Admin authentication -------------------------------------------------
# Generate the hash and secret with:  python -m app.scripts.hash_password
#
# WRAP THE HASH IN SINGLE QUOTES. A bcrypt hash contains '$', and Docker
# Compose interpolates env_file values: unquoted or double-quoted, the
# '$v09qorO...' segment is read as an empty variable and the hash arrives
# truncated, so every login fails with "Invalid salt". Single quotes are
# taken literally. Verify with:
#     docker compose exec api printenv ADMIN_PASSWORD_HASH
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
JWT_SECRET=''
JWT_EXPIRE_MINUTES=480

# --- Contact form notifications (Resend) ----------------------------------
# RESEND_FROM must be on a domain verified in Resend; a plain gmail.com
# address will be rejected as a sender.
RESEND_API_KEY=
RESEND_FROM=website@casnaggi.org
NOTIFY_TO=casnaggi@gmail.com

# --- Event images (Cloudinary) --------------------------------------------
# Only the cloud name and API key ever reach the browser, alongside a
# short-lived signature. The secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=casnaggi/events

ENVIRONMENT=production
